// jeans_hunter v1.0 — schema inicial
// Lead = loja prospectada via Google Places (com qualificacao adaptada)
// Product = mercadoria cadastrada pra catalogo
// MessageLog = historico de mensagens enviadas (auditoria + LGPD)
// User = usuario do painel (multi-user, papel ADMIN/VENDEDOR)
// AuditLog = trilha de auditoria de todas as acoes

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FunnelStage {
  NOVO_LEAD
  MENSAGEM_ENVIADA
  RESPONDEU
  EM_NEGOCIACAO
  CATALOGO_ENVIADO
  PEDIDO_FEITO
  CLIENTE
  SEM_RESPOSTA
  RECUSOU
  PAUSADO
  SEM_WHATSAPP // loja sem zap — nao da pra abordar pelo canal principal
}

enum BusinessKind {
  FABRICANTE // fabrica a propria mercadoria (concorrente/menos propenso a comprar)
  VAREJISTA  // so revende — cliente-alvo
  INDEFINIDO // nao deu pra inferir pelo nome
}

enum StoreType {
  MODA       // loja generica de roupa
  FEMININA   // moda feminina
  MASCULINA  // moda masculina
  JEANS      // especializada em jeans
  MULTIMARCA // loja multimarca
  MISTA      // varios publicos
  OUTROS
}

model Lead {
  id              String       @id @default(cuid())
  placeId         String       @unique @map("place_id")
  name            String
  city            String
  state           String       @db.Char(2)
  address         String?
  phone           String?
  whatsapp        String?      // extraido de wa.me ou normalizado do phone
  instagram       String?      // extraido do websiteUri quando for instagram.com
  website         String?
  lat             Float?
  lng             Float?
  rating          Float?
  reviewCount     Int?         @map("review_count")
  storeType       StoreType    @default(OUTROS) @map("store_type")
  businessKind    BusinessKind @default(INDEFINIDO) @map("business_kind")
  responsibleName String?      @map("responsible_name") // preenchimento manual
  foundedAt       DateTime?    @map("founded_at")        // tempo de existencia (manual ou via CNPJ na v1.5)
  funnelStage     FunnelStage  @default(NOVO_LEAD) @map("funnel_stage")
  notes           String?      @db.Text
  optOut          Boolean      @default(false) @map("opt_out")
  optOutAt        DateTime?    @map("opt_out_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  messages        MessageLog[]
  conversation    Conversation?
  outreachTasks   OutreachTask[]

  @@index([city, state])
  @@index([state])
  @@index([storeType])
  @@index([businessKind])
  @@index([funnelStage])
  @@map("leads")
}

model MessageLog {
  id        String   @id @default(cuid())
  leadId    String   @map("lead_id")
  channel   String   // "whatsapp" | "instagram" | "email"
  message   String   @db.Text
  sentAt    DateTime @default(now()) @map("sent_at")

  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("message_logs")
}

model Product {
  id                String   @id @default(cuid())
  name              String
  description       String?  @db.Text
  images            String[] // paths/URLs das fotos (frente/costas/lateral/detalhe/etiqueta)
  videos            String[] // paths/URLs de videos curtos (360, peca em movimento)
  sizes             String[] // ["36", "38", "40"...]
  wholesalePriceMin Float?   @map("wholesale_price_min")
  wholesalePriceMax Float?   @map("wholesale_price_max")
  retailPrice       Float?   @map("retail_price") // ancoragem ("varejo R$X, seu atacado R$Y")
  tags              String[] // ["feminino", "skinny", "jeans escuro"]
  categories        String[] // slugs curados (src/lib/categories.ts) — dirigem o menu do catalogo
  colors            Json?    // [{name, hex, image}] — cores; image (opcional) vincula a uma foto
  active            Boolean  @default(true)
  minOrderQty       Int      @default(10) @map("min_order_qty")  // pedido minimo por produto
  readyToShip       Boolean  @default(true) @map("ready_to_ship") // pronta-entrega
  supplierId        String?   @map("supplier_id") // fornecedor/faccao de origem (gestao interna)
  supplier          Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([active])
  @@index([supplierId])
  @@map("products")
}

// Fornecedor / faccao que fornece as pecas da vitrine. Uso interno (admin) —
// nao aparece no catalogo publico. Um fornecedor tem varios produtos.
model Supplier {
  id          String    @id @default(cuid())
  name        String
  contactName String?   @map("contact_name")
  phone       String?
  whatsapp    String?
  email       String?
  city        String?
  state       String?   @db.Char(2)
  productLine String?   @map("product_line") // o que fornece (ex.: "jeans masculino")
  notes       String?   @db.Text
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  products    Product[]

  @@index([active])
  @@map("suppliers")
}

// Pagina institucional "Sobre nos" — conteudo unico (singleton, id fixo "about")
// alimentado pelo painel e exibido em /sobre.
model AboutPage {
  id           String   @id @default("about")
  heroTitle    String   @map("hero_title")
  heroSubtitle String   @default("") @map("hero_subtitle")
  storyHtml    String   @db.Text @map("story_html") // narrativa em HTML (rich text)
  highlights   Json     // [{title, description}] — diferenciais
  stats        Json     // [{value, label}] — barra de destaques
  imageUrl     String?  @map("image_url")           // imagem de topo (opcional)
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("about_pages")
}

// ==========================================================================
//  Prospeccao automatizada — o "core" que gere agendamento, envio, conversa
//  com IA, follow-ups e passagem pro humano.
// ==========================================================================

enum ConversationStatus {
  AGENDADO        // tem contato agendado, ainda nao enviado
  ENVIADO         // 1a mensagem saiu, aguardando resposta
  RESPONDEU       // a loja respondeu — IA conduz a conversa
  EM_NEGOCIACAO   // sinalizou interesse concreto
  ASSUMIDO_HUMANO // humano assumiu (IA desligada nesta conversa)
  SEM_RESPOSTA    // esgotou os follow-ups (5 dias) sem resposta
  ENCERRADO       // recusou / concluido
  FALHOU          // erro de envio persistente
}

enum MessageDirection {
  ENTRADA // recebida da loja
  SAIDA   // enviada por nos (IA ou humano)
}

enum OutreachTaskStatus {
  PENDENTE
  ENVIADO
  FALHOU
  CANCELADO
}

/// Conversa com uma loja (1 por lead). Guarda o estado da maquina.
model Conversation {
  id             String             @id @default(cuid())
  leadId         String             @unique @map("lead_id")
  status         ConversationStatus @default(AGENDADO)
  /// Kill-switch por conversa: false = IA nao responde nem faz follow-up.
  aiEnabled      Boolean            @default(true) @map("ai_enabled")
  /// Quem assumiu manualmente (null = ninguem assumiu).
  humanOwnerId   String?            @map("human_owner_id")
  /// Quantos follow-ups ja sairam (0..4 — 24h, 48h, 72h, 5d).
  followUpStage  Int                @default(0) @map("follow_up_stage")
  /// Falhas seguidas de envio. Depois de 3, a conversa vai pra FALHOU em vez
  /// de ficar tentando de 2 em 2 horas pra sempre.
  followUpFailures Int              @default(0) @map("follow_up_failures")
  /// Quando o motor deve agir de novo (proximo follow-up). Null = nada agendado.
  nextActionAt   DateTime?          @map("next_action_at")
  lastInboundAt  DateTime?          @map("last_inbound_at")
  lastOutboundAt DateTime?          @map("last_outbound_at")
  closedAt       DateTime?          @map("closed_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  lead           Lead                  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  humanOwner     User?                 @relation(fields: [humanOwnerId], references: [id], onDelete: SetNull)
  messages       ConversationMessage[]
  tasks          OutreachTask[]

  @@index([status])
  @@index([nextActionAt])
  @@map("conversations")
}

/// Cada mensagem trocada (entrada e saida), pra IA ter o fio da conversa.
model ConversationMessage {
  id             String           @id @default(cuid())
  conversationId String           @map("conversation_id")
  direction      MessageDirection
  body           String           @db.Text
  /// true = redigida pela IA; false = escrita/enviada por humano.
  viaAi          Boolean          @default(false) @map("via_ai")
  /// id da mensagem no canal (WhatsApp), pra deduplicar webhooks/eventos.
  externalId     String?          @unique @map("external_id")
  error          String?          @db.Text
  /// Numero que REALMENTE recebeu (o WhatsApp confirma a conta; pode diferir do
  /// cadastro por causa do nono digito). Null em mensagem de entrada.
  deliveredTo    String?          @map("delivered_to")
  /// Veredito do servidor do WhatsApp: SERVIDOR | ENTREGUE | LIDA | ERRO.
  /// Null = nao houve retorno (mensagem antiga ou canal sem confirmacao).
  deliveryStatus String?          @map("delivery_status")
  /// Motivo quando ERRO (ex.: 463 = conta restrita pra iniciar conversas).
  deliveryError  String?          @map("delivery_error")
  createdAt      DateTime         @default(now()) @map("created_at")

  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("conversation_messages")
}

/// Lote de agendamento ("10 contatos as 09h de 12/08").
model OutreachBatch {
  id           String         @id @default(cuid())
  scheduledFor DateTime       @map("scheduled_for")
  note         String?
  createdById  String?        @map("created_by_id")
  createdAt    DateTime       @default(now()) @map("created_at")

  createdBy    User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  tasks        OutreachTask[]

  @@index([scheduledFor])
  @@map("outreach_batches")
}

/// Um contato agendado pra uma loja. O motor varre por scheduledFor.
model OutreachTask {
  id             String             @id @default(cuid())
  batchId        String?            @map("batch_id")
  leadId         String             @map("lead_id")
  conversationId String?            @map("conversation_id")
  scheduledFor   DateTime           @map("scheduled_for")
  status         OutreachTaskStatus @default(PENDENTE)
  /// Marcada quando o motor "pega" a tarefa. E o claim atomico que impede
  /// dois ticks (ou duas instancias do worker) mandarem a mesma mensagem.
  claimedAt      DateTime?          @map("claimed_at")
  attempts       Int                @default(0)
  lastError      String?            @db.Text @map("last_error")
  sentAt         DateTime?          @map("sent_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  batch          OutreachBatch?     @relation(fields: [batchId], references: [id], onDelete: SetNull)
  lead           Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  conversation   Conversation?      @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([status, scheduledFor])
  @@index([leadId])
  @@map("outreach_tasks")
}

/// Configuracao unica (singleton "ai") do vendedor de IA e das travas de envio.
model AiSettings {
  id              String   @id @default("ai")
  /// Liga/desliga a automacao inteira (kill-switch global).
  enabled         Boolean  @default(false)
  /// Tom de voz e roteiro — editaveis pelo painel, nao mensagens fixas.
  tone            String   @db.Text
  scriptGuidance  String   @db.Text @map("script_guidance")
  /// Travas anti-banimento (o canal nao-oficial pune volume e horario ruim).
  dailyCap        Int      @default(30) @map("daily_cap")
  minGapSeconds   Int      @default(45) @map("min_gap_seconds")
  maxGapSeconds   Int      @default(180) @map("max_gap_seconds")
  windowStartHour Int      @default(9) @map("window_start_hour")
  windowEndHour   Int      @default(18) @map("window_end_hour")
  sendOnWeekends  Boolean  @default(false) @map("send_on_weekends")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("ai_settings")
}

enum ChannelState {
  DESCONECTADO
  AGUARDANDO_QR
  CONECTADO
}

/// Estado do canal de WhatsApp (worker) publicado pro painel. Singleton "wa".
/// O worker escreve; o painel le. E o unico canal entre os dois processos.
model ChannelStatus {
  id              String       @id @default("wa")
  state           ChannelState @default(DESCONECTADO)
  /// Payload cru do QR atual. Expira em segundos — o worker regrava a cada novo.
  qr              String?      @db.Text
  qrUpdatedAt     DateTime?    @map("qr_updated_at")
  connectedPhone  String?      @map("connected_phone")
  connectedAt     DateTime?    @map("connected_at")
  lastError       String?      @db.Text @map("last_error")
  /// Ultimo sinal de vida do worker — sem isso, "conectado" poderia ser um
  /// estado velho de um processo que morreu.
  heartbeatAt     DateTime?    @map("heartbeat_at")
  /// O painel pede a desconexao aqui; o worker obedece e limpa a sessao.
  logoutRequested Boolean      @default(false) @map("logout_requested")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@map("channel_status")
}

/// Identidade visual editavel pelo painel (singleton "brand"). Sem logo
/// enviada, o sistema usa o monograma SVG embutido.
model BrandSettings {
  id         String   @id @default("brand")
  /// Logo horizontal (cabecalho do site e do painel).
  logoUrl    String?  @map("logo_url")
  /// Simbolo quadrado (icone/avatar). Cai pra logoUrl quando ausente.
  markUrl    String?  @map("mark_url")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("brand_settings")
}

enum Role {
  ADMIN
  VENDEDOR
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  name         String?
  role         Role       @default(VENDEDOR)
  active       Boolean    @default(true)
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  auditLogs      AuditLog[]
  conversations  Conversation[]
  outreachBatches OutreachBatch[]

  @@map("users")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  actorEmail String?  @map("actor_email") // snapshot — sobrevive se o usuario for excluido
  action     String   // LOGIN, LOGIN_FALHOU, LOGOUT, CRIAR, ATUALIZAR, EXCLUIR, MENSAGEM, BUSCA, FUNIL
  entityType String?  @map("entity_type") // Lead, Product, User, Message, ...
  entityId   String?  @map("entity_id")
  summary    String   @db.Text
  changes    Json?    // { campo: { from, to } } ou metadados
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
